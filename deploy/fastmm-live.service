# FastMM live trading. One unit per engine: one config, one journal directory, one status file.
# Install and edit the paths: docs/how-to/operations/deploy.md#run-under-systemd
[Unit]
Description=FastMM live trading engine
# A crash loop stops after five starts in ten minutes.
StartLimitIntervalSec=600
StartLimitBurst=5
Documentation=https://ziy.bio/FastMM/how-to/operations/deploy/
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=exec
User=fastmm
Group=fastmm
WorkingDirectory=/var/lib/fastmm
# FASTMM_CONFIG and the API keys the config reads as ${VAR}. Root-owned, mode 0600; an unset
# variable makes fastmm-live exit 2 before it connects.
EnvironmentFile=/etc/fastmm/fastmm-live.env
ExecStart=/opt/fastmm/bin/fastmm-live --config ${FASTMM_CONFIG}

# A crash or a transient failure (a signal, exit 4) comes back into service: the position is
# restored from the store plus the venue's executions, orders the dead process left are swept and
# cancelled, and the kill switch and the max-loss budget carry over. 2 and 3 need a config fix;
# 5, 6 and 7 need a human (docs/reference/errors.md), and a latched kill exits 6 at every start.
Restart=on-failure
RestartPreventExitStatus=2 3 5 6 7
RestartSec=2
# SIGTERM cancels every order over REST before the process exits; give it room.
KillSignal=SIGTERM
TimeoutStopSec=90

# [engine] lock_memory = true calls mlockall(); without this the call fails and logs a warning.
LimitMEMLOCK=infinity
LimitNOFILE=65536
# Never swap the engine out; kill the unit rather than let the OOM killer pick another process.
MemorySwapMax=0
OOMPolicy=stop
OOMScoreAdjust=-500

# The cores the engine may use: a superset of [engine] cpu and net_cpus, and disjoint from the
# cores other work runs on. Pair it with isolcpus, nohz_full and rcu_nocbs on the kernel command
# line (scripts/host-setup.sh tune). Remove the line on a shared host, where [engine] cpu = -1.
CPUAffinity=2 3

# stderr carries the lines at [logging] mirror_level and above; [logging] file takes the full log
# and needs your own rotation.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fastmm-live

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# runs/ (journals, epoch file, kill file) and the config directory.
ReadWritePaths=/var/lib/fastmm
ReadOnlyPaths=/etc/fastmm

[Install]
WantedBy=multi-user.target
