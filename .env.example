# Copy to .env and `source` it, or export in your shell. Never commit real keys.
FASTMM_BINANCE_API_KEY=
FASTMM_BINANCE_API_SECRET=
FASTMM_BYBIT_API_KEY=
FASTMM_BYBIT_API_SECRET=
# OKX demo trading API key: the key, its secret and the passphrase chosen with it.
FASTMM_OKX_API_KEY=
FASTMM_OKX_API_SECRET=
FASTMM_OKX_API_PASSPHRASE=
# Deribit testnet API key: client id and client secret.
FASTMM_DERIBIT_CLIENT_ID=
FASTMM_DERIBIT_CLIENT_SECRET=
# Opt-in Binance live test environment: testnet (default) or demo.
FASTMM_BINANCE_ENV=testnet
# Set to 1 to enable opt-in tests that talk to exchange testnets.
FASTMM_LIVE_TESTS=0
